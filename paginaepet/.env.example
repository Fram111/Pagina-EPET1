# Copiar este archivo como .env.local y completar con los datos del proyecto Supabase.
# Estas dos variables son públicas y aptas para el frontend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA_ANON

# Nunca poner la service_role key ni secretos de Supabase en variables VITE_.
